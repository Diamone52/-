<Window x:Class="PulseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пульс — контроль тренировочного процесса"
        Height="820" Width="1280" MinHeight="600" MinWidth="960"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Боковая панель ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource BgSunkenBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22">
                <DockPanel DockPanel.Dock="Top" Margin="8,0,0,26" LastChildFill="True">
                    <Button x:Name="ThemeToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}"
                            VerticalAlignment="Top" ToolTip="Сменить тему" Click="ThemeToggle_Click"/>
                    <StackPanel>
                        <TextBlock Text="Пульс" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource DisplayFontFamily}"/>
                        <TextBlock Text="трекер тренировок" FontSize="11" Foreground="{DynamicResource InkFaintBrush}"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavDashboard" Content="Обзор" Tag="Dashboard" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLog" Content="Дневник" Tag="Log" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPlans" Content="Планы" Tag="Plans" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavExercises" Content="Упражнения" Tag="Exercises" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavProgress" Content="Прогресс" Tag="Progress" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavProfile" Content="Профиль" Tag="Profile" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAdmin" Content="Пользователи" Tag="Admin" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,4,0">
                    <Button Content="Выйти" Style="{StaticResource GhostButtonStyle}" Padding="0,4"
                            HorizontalAlignment="Left" HorizontalContentAlignment="Left" Click="Logout_Click" Margin="0,0,0,10"/>
                    <TextBlock Text="Данные хранятся локально, в базе SQLite" FontSize="10"
                               Foreground="{DynamicResource InkFaintBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Контент ===================== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="34,28,34,40">

                <!-- ===== ОБЗОР ===== -->
                <Grid x:Name="DashboardPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="+ Записать тренировку" Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Bottom" Click="OpenSession_Click"/>
                        <StackPanel>
                            <TextBlock Text="Обзор" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFontFamily}"/>
                            <TextBlock x:Name="TodayText" Foreground="{DynamicResource InkDimBrush}" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel x:Name="StatsPanel" Grid.Row="1"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Последние тренировки" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" FontFamily="{StaticResource DisplayFontFamily}"/>
                                <TextBlock Text="Пять недавних записей дневника" Foreground="{DynamicResource InkFaintBrush}" FontSize="11.5" Margin="0,0,0,12"/>
                                <StackPanel x:Name="RecentSessionsPanel"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Личные рекорды" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" FontFamily="{StaticResource DisplayFontFamily}"/>
                                <TextBlock Text="Максимальный рабочий вес по упражнениям" Foreground="{DynamicResource InkFaintBrush}" FontSize="11.5" Margin="0,0,0,12"/>
                                <StackPanel x:Name="RecordsPanel"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== ДНЕВНИК ===== -->
                <Grid x:Name="LogPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="+ Записать тренировку" Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Bottom" Click="OpenSession_Click"/>
                        <StackPanel>
                            <TextBlock Text="Дневник тренировок" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFontFamily}"/>
                            <TextBlock Text="Календарь и полная история занятий" Foreground="{DynamicResource InkDimBrush}" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CalendarPanelBorder" Style="{StaticResource PanelStyle}" VerticalAlignment="Top"
                                Cursor="Hand" ToolTip="Нажмите на календарь, чтобы сменить тему"
                                MouseLeftButtonUp="CalendarPanel_Click">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Left" Content="←" Style="{StaticResource GhostButtonStyle}" Click="CalPrev_Click"/>
                                    <Button DockPanel.Dock="Right" Content="→" Style="{StaticResource GhostButtonStyle}" Click="CalNext_Click"/>
                                    <TextBlock x:Name="CalTitleText" HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFontFamily}"/>
                                </DockPanel>
                                <UniformGrid x:Name="CalendarDowRow" Columns="7" Margin="0,0,0,4"/>
                                <UniformGrid x:Name="CalendarGrid" Columns="7"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Вся история" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" FontFamily="{StaticResource DisplayFontFamily}"/>
                                <TextBlock Text="Нажмите на тренировку для просмотра" Foreground="{DynamicResource InkFaintBrush}" FontSize="11.5" Margin="0,0,0,12"/>
                                <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="FullSessionsPanel"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== ПЛАНЫ ===== -->
                <Grid x:Name="PlansPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="+ Новый план" Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Bottom" Click="AddPlan_Click"/>
                        <StackPanel>
                            <TextBlock Text="Планы тренировок" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFontFamily}"/>
                            <TextBlock Text="Шаблоны занятий: набор упражнений с целевыми подходами" Foreground="{DynamicResource InkDimBrush}" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel x:Name="PlansPanel" Grid.Row="1" Orientation="Horizontal"/>
                </Grid>

                <!-- ===== УПРАЖНЕНИЯ ===== -->
                <Grid x:Name="ExercisesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="+ Добавить упражнение" Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Bottom" Click="AddExercise_Click"/>
                        <StackPanel>
                            <TextBlock Text="Упражнения" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFontFamily}"/>
                            <TextBlock Text="Справочник упражнений вашей программы" Foreground="{DynamicResource InkDimBrush}" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                        <StackPanel x:Name="ExercisesPanel"/>
                    </Border>
                </Grid>

                <!-- ===== ПРОГРЕСС ===== -->
                <Grid x:Name="ProgressPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <ComboBox DockPanel.Dock="Right" x:Name="ProgressExerciseCombo" Width="240" VerticalAlignment="Bottom"
                                  DisplayMemberPath="Name" SelectionChanged="ProgressExercise_Changed"/>
                        <StackPanel>
                            <TextBlock Text="Прогресс" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFontFamily}"/>
                            <TextBlock Text="Динамика рабочих весов и общий объём нагрузки" Foreground="{DynamicResource InkDimBrush}" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock x:Name="ProgressExerciseTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" FontFamily="{StaticResource DisplayFontFamily}"/>
                                <TextBlock Text="Максимальный рабочий вес по тренировкам, кг" Foreground="{DynamicResource InkFaintBrush}" FontSize="11.5" Margin="0,0,0,12"/>
                                <Canvas x:Name="LineChartCanvas" Height="240" Background="Transparent" SizeChanged="Chart_SizeChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Недельный объём" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" FontFamily="{StaticResource DisplayFontFamily}"/>
                                <TextBlock Text="Суммарный тоннаж всех упражнений по неделям" Foreground="{DynamicResource InkFaintBrush}" FontSize="11.5" Margin="0,0,0,12"/>
                                <Canvas x:Name="BarChartCanvas" Height="240" Background="Transparent" SizeChanged="Chart_SizeChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== ПРОФИЛЬ ===== -->
                <Grid x:Name="ProfilePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Профиль" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFontFamily}"/>
                        <TextBlock Text="Учётные данные и все ваши планы тренировок" Foreground="{DynamicResource InkDimBrush}" FontSize="14" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,20" HorizontalAlignment="Left" MinWidth="360">
                        <StackPanel>
                            <TextBlock x:Name="ProfileNameText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Почта" Foreground="{DynamicResource InkFaintBrush}" FontSize="12.5"/>
                                <TextBlock x:Name="ProfileEmailText" Grid.Column="1" FontSize="13.5"/>
                            </Grid>
                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Роль" Foreground="{DynamicResource InkFaintBrush}" FontSize="12.5"/>
                                <TextBlock x:Name="ProfileRoleText" Grid.Column="1" FontSize="13.5"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="В приложении с" Foreground="{DynamicResource InkFaintBrush}" FontSize="12.5"/>
                                <TextBlock x:Name="ProfileCreatedText" Grid.Column="1" FontSize="13.5"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Мои планы тренировок" FontSize="19" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4"/>
                        <TextBlock Text="Все шаблоны тренировок, которые у вас есть" Foreground="{DynamicResource InkFaintBrush}" FontSize="11.5" Margin="0,0,0,12"/>
                        <WrapPanel x:Name="ProfilePlansPanel" Orientation="Horizontal"/>
                    </StackPanel>
                </Grid>

                <!-- ===== ПОЛЬЗОВАТЕЛИ (АДМИН) ===== -->
                <Grid x:Name="AdminPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Пользователи" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFontFamily}"/>
                        <TextBlock Text="Все зарегистрированные пользователи. Можно назначить тренировку из одного из планов пользователя." Foreground="{DynamicResource InkDimBrush}" FontSize="14" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                        <StackPanel x:Name="AdminUsersPanel"/>
                    </Border>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
