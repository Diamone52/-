<Window x:Class="PulseTracker.Dialogs.AssignTrainingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначить тренировку" Width="460" SizeToContent="Height"
        Background="{DynamicResource BgRaisedBrush}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,4" FontFamily="{StaticResource DisplayFontFamily}"/>
        <TextBlock x:Name="SubtitleText" FontSize="12.5" Foreground="{DynamicResource InkFaintBrush}" Margin="0,0,0,18"/>

        <TextBlock Text="Дата" Style="{StaticResource LabelStyle}"/>
        <DatePicker x:Name="DatePickerBox" Margin="0,0,0,14"/>

        <TextBlock Text="План пользователя" Style="{StaticResource LabelStyle}"/>
        <ComboBox x:Name="PlanCombo" DisplayMemberPath="Name" SelectionChanged="PlanCombo_SelectionChanged" Margin="0,0,0,14"/>

        <TextBlock Text="Название тренировки" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Длительность (мин)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="DurationBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="RPE 1–10" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="RpeBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Заметки" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="NotesBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button Content="Назначить" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
