<Window x:Class="PulseTracker.Dialogs.SessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тренировка" Width="620" SizeToContent="Height" MaxHeight="820"
        Background="{DynamicResource BgRaisedBrush}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="800">
        <StackPanel Margin="24">
            <TextBlock x:Name="TitleText" Text="Новая тренировка" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18" FontFamily="{StaticResource DisplayFontFamily}"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Дата" Style="{StaticResource LabelStyle}"/>
                    <DatePicker x:Name="DatePickerBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Начать из плана (необязательно)" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="PlanCombo" SelectionChanged="PlanCombo_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Название тренировки" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,16"/>

            <TextBlock Text="Упражнения" Style="{StaticResource LabelStyle}"/>
            <StackPanel x:Name="ExercisesPanel" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="AddExerciseCombo" Grid.Column="0" DisplayMemberPath="Name"/>
                <Button Grid.Column="2" Content="Добавить упражнение" Style="{StaticResource SmallButtonStyle}" Click="AddExercise_Click"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Длительность (мин)" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="DurationBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Нагрузка по ощущению, RPE 1–10" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="RpeBox"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Заметки" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="NotesBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>

            <Grid Margin="0,20,0,0">
                <Button x:Name="DeleteBtn" Content="Удалить" Style="{StaticResource DangerGhostButtonStyle}" HorizontalAlignment="Left" Click="Delete_Click" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="Сохранить тренировку" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
