<Window x:Class="PulseTracker.Dialogs.DayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="День" Width="420" SizeToContent="Height" MaxHeight="560"
        Background="{DynamicResource BgRaisedBrush}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16" FontFamily="{StaticResource DisplayFontFamily}"/>
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SessionsPanel"/>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Закрыть" Style="{StaticResource GhostButtonStyle}" Click="Close_Click" Margin="0,0,10,0"/>
            <Button x:Name="AddBtn" Content="+ Тренировка в этот день" Style="{StaticResource PrimaryButtonStyle}" Click="Add_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
